#include <windows.h>

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
1 RT_MANIFEST "NeNeFolio.manifest"

1 VERSIONINFO
 FILEVERSION NENEFOLIO_RC_VERSION
 PRODUCTVERSION NENEFOLIO_RC_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "HideyukiMORI"
            VALUE "FileDescription", "NeNe Folio"
            VALUE "FileVersion", NENEFOLIO_WINDOWS_VERSION
            VALUE "InternalName", "NeNeFolio"
            VALUE "OriginalFilename", "NeNeFolio.exe"
            VALUE "ProductName", "NeNe Folio"
            VALUE "ProductVersion", NENEFOLIO_PRODUCT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
